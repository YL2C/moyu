[Unit]
Description=Moyu temporary model relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moyu-relay
Group=moyu-relay
WorkingDirectory=/opt/moyu/server
EnvironmentFile=/etc/moyu-relay.env
ExecStart=/usr/bin/node /opt/moyu/server/relay.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=384M

[Install]
WantedBy=multi-user.target
